{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "strata",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "apps/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/ddl/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/import/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/metamodel/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/query/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/storage/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "deploy/helm/strata/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "deploy/helm/strata/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "generic",
          "path": "packages/cli/src/version.ts"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ]
}
