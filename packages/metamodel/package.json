{
  "name": "@strata/metamodel",
  "version": "1.0.3",
  "type": "module",
  "description": "Core metamodel: conceptual, logical and physical model objects, references and validation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "schema": "tsx scripts/build-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "yaml": "2.9.0",
    "zod-to-json-schema": "3.25.2"
  }
}
